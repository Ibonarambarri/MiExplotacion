# Cadena de conexión a Postgres (Neon, Supabase, Vercel Marketplace, etc.)
# Ejemplo: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Contraseña única de acceso a la app (login)
APP_PASSWORD=

# Secreto para firmar la cookie de sesión. Mínimo 32 caracteres aleatorios.
# Genéralo con:  openssl rand -base64 48
SESSION_SECRET=
