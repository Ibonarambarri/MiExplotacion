# Cadena de conexión a Postgres (Neon, Supabase, Vercel Marketplace, etc.)
# Ejemplo: postgresql://user:password@host:5432/dbname?sslmode=require
# Modo demo sin servidor (PGlite embebido): pglite://./.data/demo
DATABASE_URL=

# Contraseña única de acceso a la app (login)
APP_PASSWORD=

# Secreto para firmar la cookie de sesión. Mínimo 32 caracteres aleatorios.
# Genéralo con:  openssl rand -base64 48
SESSION_SECRET=

# ─── Notificaciones push (opcional) ─────────────────────────────────────────
# Si faltan, la app funciona igual pero sin notificaciones.
# Genera el par de claves con:  npx web-push generate-vapid-keys
# y copia la "Public Key" en VAPID_PUBLIC_KEY y en NEXT_PUBLIC_VAPID_PUBLIC_KEY
# (la misma), y la "Private Key" en VAPID_PRIVATE_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del responsable (mailto: o https:), lo exige el protocolo Web Push.
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Clave pública expuesta al navegador para suscribirse (igual que VAPID_PUBLIC_KEY).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Recordatorio diario (Vercel Cron) ──────────────────────────────────────
# Vercel envía "Authorization: Bearer <CRON_SECRET>" a /api/cron/reminders.
# Genéralo con:  openssl rand -base64 32
CRON_SECRET=
